---
import FormattedDate from './FormattedDate.astro';
import Tags from './Tags.astro';
import { postUrl, type Post } from '../lib/posts';
interface Props {
	posts: Post[];
}
const { posts } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="empty">아직 글이 없습니다.</p>
	) : (
		<ul class="post-list">
			{posts.map((post) => (
				<li class="post-item">
					<a class="post-link" href={postUrl(post)}>
						<h3 class="post-title">
							{post.data.title}
							{post.data.draft && <span class="draft">초안</span>}
						</h3>
						{post.data.description && <p class="post-desc">{post.data.description}</p>}
					</a>
					<div class="post-meta">
						<FormattedDate date={post.data.pubDate} />
						<Tags tags={post.data.tags} />
					</div>
				</li>
			))}
		</ul>
	)
}

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.post-item {
		padding: 1.25em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.post-item:last-child {
		border-bottom: none;
	}
	.post-link {
		text-decoration: none;
		color: inherit;
	}
	.post-title {
		margin: 0 0 0.3em 0;
		font-size: 1.4em;
		line-height: 1.3;
		color: rgb(var(--black));
		transition: 0.15s ease;
	}
	.post-link:hover .post-title {
		color: var(--accent);
	}
	.post-desc {
		margin: 0 0 0.5em 0;
		color: rgb(var(--gray-dark));
		font-size: 0.95em;
	}
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1em;
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
	.draft {
		margin-left: 0.5em;
		padding: 0.1em 0.5em;
		border-radius: 4px;
		background: #ffe8a3;
		color: #7a5a00;
		font-size: 0.55em;
		vertical-align: middle;
	}
	.empty {
		color: rgb(var(--gray));
	}
</style>

---
import FormattedDate from './FormattedDate.astro';
import Tags from './Tags.astro';
import { postUrl, type Post } from '../lib/posts';
interface Props {
	posts: Post[];
}
const { posts } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="empty">아직 글이 없습니다.</p>
	) : (
		<ul class="post-list">
			{posts.map((post) => (
				<li class="post">
					<a class="post-link" href={postUrl(post)}>
						<h3 class="post-title">
							{post.data.title}
							{post.data.draft && <span class="draft">초안</span>}
						</h3>
						{post.data.description && <p class="post-desc">{post.data.description}</p>}
					</a>
					<div class="post-meta">
						<FormattedDate date={post.data.pubDate} />
						<Tags tags={post.data.tags} />
					</div>
				</li>
			))}
		</ul>
	)
}

<style>
	.post-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.post {
		margin: 0 calc(var(--space-4) * -1);
		padding: var(--space-5) var(--space-4);
		border-radius: var(--radius-lg);
		transition: background-color var(--duration-fast) var(--ease-standard);
	}
	.post:hover {
		background: var(--color-surface-hover);
	}
	.post-link {
		display: block;
		color: inherit;
	}
	.post-title {
		font-size: var(--text-lg);
		font-weight: var(--weight-semibold);
		line-height: var(--leading-snug);
		transition: color var(--duration-fast) var(--ease-standard);
	}
	.post-link:hover .post-title {
		color: var(--color-accent);
	}
	.post-desc {
		margin-top: var(--space-1);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
	}
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3);
		margin-top: var(--space-3);
		color: var(--color-text-subtle);
		font-size: var(--text-sm);
	}
	.draft {
		margin-left: var(--space-2);
		padding: var(--space-0) var(--space-2);
		border-radius: var(--radius-sm);
		background: var(--color-draft-bg);
		color: var(--color-draft-text);
		font-size: var(--text-xs);
		font-weight: var(--weight-medium);
		vertical-align: middle;
	}
	.empty {
		color: var(--color-text-muted);
	}
	@media (max-width: 40rem) {
		.post {
			margin: 0 calc(var(--space-2) * -1);
			padding: var(--space-4) var(--space-2);
		}
	}
</style>

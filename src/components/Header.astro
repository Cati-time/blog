---
import { SITE } from '../consts';
import { CATEGORIES, PLATFORMS, categoryUrl } from '../lib/posts';
import HeaderLink from './HeaderLink.astro';
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
	<nav class="nav" aria-label="주 메뉴">
		<a class="brand" href={base}>{SITE.title}</a>
		<ul class="menus">
			{
				CATEGORIES.map((c) => (
					<li class="menu">
						<HeaderLink href={categoryUrl(c.id)} class="menu-trigger">
							{c.label}
							<svg class="caret" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
								<path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
							</svg>
						</HeaderLink>
						<div class="menu-panel">
							<ul>
								<li>
									<a href={categoryUrl(c.id)}>전체 보기</a>
								</li>
								{PLATFORMS.map((p) => (
									<li>
										<a href={categoryUrl(c.id, p.id)}>{p.label}</a>
									</li>
								))}
							</ul>
						</div>
					</li>
				))
			}
		</ul>
		<div class="secondary">
			<HeaderLink href={`${base}tags/`}>태그</HeaderLink>
			<HeaderLink href={`${base}about/`}>소개</HeaderLink>
		</div>
		<div class="actions">
			<a class="icon-btn" href={`${base}rss.xml`} title="RSS">
				<span class="sr-only">RSS 피드</span>
				<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
					<path
						d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"></path>
					<circle cx="5" cy="19" r="1.5" fill="currentColor"></circle>
				</svg>
			</a>
			{
				SITE.github && (
					<a class="icon-btn" href={SITE.github} target="_blank" rel="noopener" title="GitHub">
						<span class="sr-only">GitHub</span>
						<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
							<path
								fill="currentColor"
								d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
							/>
						</svg>
					</a>
				)
			}
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: var(--z-header);
		border-bottom: 1px solid var(--color-border);
		background: var(--color-header-bg);
		backdrop-filter: saturate(180%) blur(12px);
		-webkit-backdrop-filter: saturate(180%) blur(12px);
	}
	.nav {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		max-width: var(--size-page);
		height: var(--size-header);
		margin: 0 auto;
		padding: 0 var(--space-5);
	}
	.brand {
		color: var(--color-text);
		font-size: var(--text-base);
		font-weight: var(--weight-bold);
		letter-spacing: var(--tracking-tight);
		white-space: nowrap;
	}
	.brand:hover {
		color: var(--color-accent);
	}
	.menus {
		display: flex;
		gap: var(--space-1);
		margin: 0 auto 0 0;
		padding: 0;
		list-style: none;
	}
	.menu {
		position: relative;
	}
	.menu :global(.menu-trigger) {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
	}
	.caret {
		transition: transform var(--duration-fast) var(--ease-standard);
	}
	/* 드롭다운: hover·키보드 포커스로 열린다. 위쪽 여백은 마우스가 건너갈 다리 */
	.menu-panel {
		position: absolute;
		top: 100%;
		left: 0;
		padding-top: var(--space-2);
		opacity: 0;
		visibility: hidden;
		transform: translateY(calc(var(--space-1) * -1));
		transition:
			opacity var(--duration-fast) var(--ease-standard),
			transform var(--duration-fast) var(--ease-standard),
			visibility var(--duration-fast);
	}
	.menu:hover .menu-panel,
	.menu:focus-within .menu-panel {
		opacity: 1;
		visibility: visible;
		transform: none;
	}
	.menu:hover .caret,
	.menu:focus-within .caret {
		transform: rotate(180deg);
	}
	.menu-panel ul {
		min-width: 11rem;
		margin: 0;
		padding: var(--space-2);
		list-style: none;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: var(--shadow-md);
	}
	.menu-panel a {
		display: block;
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-md);
		color: var(--color-text);
		font-size: var(--text-sm);
		white-space: nowrap;
	}
	.menu-panel a:hover {
		background: var(--color-surface-hover);
		color: var(--color-accent);
	}
	.menu-panel li:first-child a {
		color: var(--color-text-muted);
	}
	.secondary {
		display: flex;
		gap: var(--space-1);
	}
	.actions {
		display: flex;
		align-items: center;
		gap: var(--space-1);
	}
	.icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--space-10);
		height: var(--space-10);
		border-radius: var(--radius-md);
		color: var(--color-text-muted);
		transition:
			background-color var(--duration-fast) var(--ease-standard),
			color var(--duration-fast) var(--ease-standard);
	}
	.icon-btn:hover {
		background: var(--color-surface-hover);
		color: var(--color-text);
	}
	/* 모바일: 드롭다운 대신 카테고리 페이지의 하위 메뉴를 쓴다 */
	@media (max-width: 40rem) {
		.nav {
			gap: var(--space-2);
			padding: 0 var(--space-4);
		}
		.brand {
			font-size: var(--text-sm);
		}
		.menu-panel,
		.caret,
		.secondary,
		.actions {
			display: none;
		}
		.menu :global(.menu-trigger) {
			font-size: var(--text-sm);
		}
	}
</style>

---
import { tagUrl } from '../lib/posts';
interface Props {
	tags: string[];
	class?: string;
}
const { tags, class: className } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class:list={['tags', className]}>
			{tags.map((tag) => (
				<li>
					<a href={tagUrl(tag)}>#{tag}</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.tags a {
		display: inline-block;
		padding: 0.1em 0.6em;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		font-size: 0.8em;
		text-decoration: none;
		transition: 0.15s ease;
	}
	.tags a:hover {
		background: var(--accent);
		color: white;
	}
</style>

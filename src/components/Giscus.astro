---
import { GISCUS } from '../consts';
const enabled = Boolean(GISCUS.repo && GISCUS.repoId && GISCUS.categoryId);
---

{
	enabled ? (
		<section class="comments" aria-label="댓글">
			<script is:inline define:vars={{ cfg: GISCUS }}>
				const pick = (t) => (t === 'dark' ? cfg.darkTheme : cfg.lightTheme);
				const s = document.createElement('script');
				s.src = 'https://giscus.app/client.js';
				const attrs = {
					repo: cfg.repo,
					'repo-id': cfg.repoId,
					category: cfg.category,
					'category-id': cfg.categoryId,
					mapping: cfg.mapping,
					strict: '0',
					'reactions-enabled': cfg.reactionsEnabled,
					'emit-metadata': cfg.emitMetadata,
					'input-position': cfg.inputPosition,
					theme: pick(document.documentElement.dataset.theme),
					lang: cfg.lang,
					loading: 'lazy',
				};
				for (const [k, v] of Object.entries(attrs)) s.setAttribute('data-' + k, v);
				s.crossOrigin = 'anonymous';
				s.async = true;
				document.currentScript.parentElement.appendChild(s);
				// 사이트 테마 전환 시 댓글창도 따라간다
				document.addEventListener('themechange', (e) => {
					const frame = document.querySelector('iframe.giscus-frame');
					frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: pick(e.detail) } } }, 'https://giscus.app');
				});
			</script>
		</section>
	) : import.meta.env.DEV ? (
		<section class="comments placeholder">
			<p>
				💬 댓글(giscus)이 아직 설정되지 않았습니다. <code>site.config.mjs</code> 의 <code>GISCUS</code> 를
				채우면 여기에 댓글창이 나타납니다. (이 안내는 개발 서버에서만 보입니다)
			</p>
		</section>
	) : null
}

<style>
	.comments {
		margin-top: var(--space-16);
		padding-top: var(--space-8);
		border-top: 1px solid var(--color-border);
	}
	.placeholder {
		color: var(--color-text-subtle);
		font-size: var(--text-sm);
	}
</style>

---
import { SITE } from '../consts';
const today = new Date();
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
	<div class="inner">
		<p>&copy; {today.getFullYear()} {SITE.author}</p>
		<nav class="links">
			<a href={`${base}rss.xml`}>RSS</a>
			{
				SITE.github && (
					<a href={SITE.github} target="_blank" rel="noopener">
						GitHub
					</a>
				)
			}
			{SITE.email && <a href={`mailto:${SITE.email}`}>Email</a>}
			<a href="https://astro.build" target="_blank" rel="noopener">Built with Astro</a>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		color: var(--color-text-subtle);
		font-size: var(--text-sm);
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		max-width: var(--size-page);
		margin: 0 auto;
		padding: var(--space-8) var(--space-5);
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
	}
	.links a {
		color: var(--color-text-subtle);
	}
	.links a:hover {
		color: var(--color-text);
	}
</style>

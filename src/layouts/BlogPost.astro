---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import Header from '../components/Header.astro';
import Tags from '../components/Tags.astro';
import { SITE } from '../consts';
import { categoryUrl, getCategory, getPlatform } from '../lib/posts';

// 글 이외의 페이지(소개 등)도 이 레이아웃을 쓰므로 tags·draft 는 선택으로 둔다
type Props = Omit<CollectionEntry<'blog'>['data'], 'tags' | 'draft' | 'category' | 'platform'> & {
	tags?: string[];
	draft?: boolean;
	category?: string;
	platform?: string;
	minutesRead?: string;
	showComments?: boolean;
	showMeta?: boolean;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	draft = false,
	category,
	platform,
	minutesRead,
	showComments = true,
	showMeta = true,
} = Astro.props;
const cat = category ? getCategory(category) : undefined;
const plat = platform ? getPlatform(platform) : undefined;

// 검색엔진용 구조화 데이터 (schema.org)
const site = Astro.site!;
const pageUrl = new URL(Astro.url.pathname, site).href;
const homeUrl = new URL(import.meta.env.BASE_URL, site).href;
const section = cat && plat ? `${cat.label} · ${plat.label}` : undefined;
const jsonLd: Record<string, unknown>[] = [
	{
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		headline: title,
		description,
		datePublished: pubDate.toISOString(),
		dateModified: (updatedDate ?? pubDate).toISOString(),
		inLanguage: SITE.lang,
		url: pageUrl,
		mainEntityOfPage: pageUrl,
		...(section && { articleSection: section }),
		...(tags.length > 0 && { keywords: tags.join(', ') }),
		author: { '@type': 'Organization', name: SITE.author, url: homeUrl },
		publisher: { '@type': 'Organization', name: SITE.title, url: homeUrl },
		isPartOf: { '@type': 'Blog', name: SITE.title, url: homeUrl },
	},
];
if (cat) {
	const crumbs = [{ name: SITE.title, url: homeUrl }, { name: cat.label, url: new URL(categoryUrl(cat.id), site).href }];
	if (plat) crumbs.push({ name: plat.label, url: new URL(categoryUrl(cat.id, plat.id), site).href });
	crumbs.push({ name: title, url: pageUrl });
	jsonLd.push({
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })),
	});
}
---

<html lang={SITE.lang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			type="article"
			article={{ published: pubDate, modified: updatedDate, section, tags }}
			jsonLd={jsonLd}
		/>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{
					cat && (
						<nav class="crumbs" aria-label="분류">
							<a href={categoryUrl(cat.id)}>{cat.label}</a>
							{plat && <span aria-hidden="true">›</span>}
							{plat && <a href={categoryUrl(cat.id, plat.id)}>{plat.label}</a>}
						</nav>
					)
				}
				<header class="post-header">
					{draft && <p class="draft-badge">초안 — 배포 목록에서 제외됨</p>}
					<h1 class="post-title">{title}</h1>
					{description && showMeta && <p class="post-desc">{description}</p>}
					{
						showMeta && (
							<div class="meta">
								<FormattedDate date={pubDate} />
								{minutesRead && <span class="dot" aria-hidden="true" />}
								{minutesRead && <span>{minutesRead} 읽기</span>}
								{updatedDate && <span class="dot" aria-hidden="true" />}
								{updatedDate && (
									<span>
										수정 <FormattedDate date={updatedDate} />
									</span>
								)}
							</div>
						)
					}
					<Tags tags={tags} class="post-tags" />
				</header>
				{
					heroImage && (
						<div class="hero">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="prose">
					<slot />
				</div>
				{showComments && <Giscus />}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.crumbs {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin-bottom: var(--space-4);
		color: var(--color-text-subtle);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
	}
	.crumbs a {
		color: var(--color-accent);
	}
	.crumbs a:hover {
		color: var(--color-accent-hover);
	}
	.post-header {
		padding-bottom: var(--space-8);
		margin-bottom: var(--space-10);
		border-bottom: 1px solid var(--color-border);
	}
	.draft-badge {
		display: inline-block;
		margin-bottom: var(--space-3);
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-sm);
		background: var(--color-draft-bg);
		color: var(--color-draft-text);
		font-size: var(--text-xs);
		font-weight: var(--weight-medium);
	}
	.post-title {
		font-size: var(--text-3xl);
		line-height: var(--leading-tight);
	}
	.post-desc {
		margin-top: var(--space-3);
		color: var(--color-text-muted);
		font-size: var(--text-lg);
		line-height: var(--leading-snug);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-5);
		color: var(--color-text-subtle);
		font-size: var(--text-sm);
	}
	.dot {
		width: 3px;
		height: 3px;
		border-radius: var(--radius-full);
		background: currentColor;
	}
	.post-header :global(.post-tags) {
		margin-top: var(--space-4);
	}
	.hero {
		margin-bottom: var(--space-10);
	}
	.hero :global(img) {
		display: block;
		width: 100%;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
	}
	@media (max-width: 40rem) {
		.post-title {
			font-size: var(--text-2xl);
		}
		.post-desc {
			font-size: var(--text-base);
		}
	}
</style>

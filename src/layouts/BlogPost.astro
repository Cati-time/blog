---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import Header from '../components/Header.astro';
import Tags from '../components/Tags.astro';
import { SITE } from '../consts';

// 글 이외의 페이지(소개 등)도 이 레이아웃을 쓰므로 tags·draft 는 선택으로 둔다
type Props = Omit<CollectionEntry<'blog'>['data'], 'tags' | 'draft'> & {
	tags?: string[];
	draft?: boolean;
	minutesRead?: string;
	showComments?: boolean;
	showMeta?: boolean;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	draft = false,
	minutesRead,
	showComments = true,
	showMeta = true,
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang={SITE.lang}>
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" />
	</head>

	<body>
		<Header />
		<main>
			<article>
				{
					showMeta && (
						<a class="back" href={`${base}posts/`}>
							← 전체 글
						</a>
					)
				}
				<header class="post-header">
					{draft && <p class="draft-badge">초안 — 배포 목록에서 제외됨</p>}
					<h1 class="post-title">{title}</h1>
					{description && showMeta && <p class="post-desc">{description}</p>}
					{
						showMeta && (
							<div class="meta">
								<FormattedDate date={pubDate} />
								{minutesRead && <span class="dot" aria-hidden="true" />}
								{minutesRead && <span>{minutesRead} 읽기</span>}
								{updatedDate && <span class="dot" aria-hidden="true" />}
								{updatedDate && (
									<span>
										수정 <FormattedDate date={updatedDate} />
									</span>
								)}
							</div>
						)
					}
					<Tags tags={tags} class="post-tags" />
				</header>
				{
					heroImage && (
						<div class="hero">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="prose">
					<slot />
				</div>
				{showComments && <Giscus />}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.back {
		display: inline-block;
		margin-bottom: var(--space-6);
		color: var(--color-text-subtle);
		font-size: var(--text-sm);
	}
	.back:hover {
		color: var(--color-accent);
	}
	.post-header {
		padding-bottom: var(--space-8);
		margin-bottom: var(--space-10);
		border-bottom: 1px solid var(--color-border);
	}
	.draft-badge {
		display: inline-block;
		margin-bottom: var(--space-3);
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-sm);
		background: var(--color-draft-bg);
		color: var(--color-draft-text);
		font-size: var(--text-xs);
		font-weight: var(--weight-medium);
	}
	.post-title {
		font-size: var(--text-3xl);
		line-height: var(--leading-tight);
	}
	.post-desc {
		margin-top: var(--space-3);
		color: var(--color-text-muted);
		font-size: var(--text-lg);
		line-height: var(--leading-snug);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-5);
		color: var(--color-text-subtle);
		font-size: var(--text-sm);
	}
	.dot {
		width: 3px;
		height: 3px;
		border-radius: var(--radius-full);
		background: currentColor;
	}
	.post-header :global(.post-tags) {
		margin-top: var(--space-4);
	}
	.hero {
		margin-bottom: var(--space-10);
	}
	.hero :global(img) {
		display: block;
		width: 100%;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
	}
	@media (max-width: 40rem) {
		.post-title {
			font-size: var(--text-2xl);
		}
		.post-desc {
			font-size: var(--text-base);
		}
	}
</style>

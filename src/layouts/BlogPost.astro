---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import Header from '../components/Header.astro';
import Tags from '../components/Tags.astro';
import { SITE } from '../consts';

// 글 이외의 페이지(소개 등)도 이 레이아웃을 쓰므로 tags·draft 는 선택으로 둔다
type Props = Omit<CollectionEntry<'blog'>['data'], 'tags' | 'draft'> & {
	tags?: string[];
	draft?: boolean;
	minutesRead?: string;
	showComments?: boolean;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	draft = false,
	minutesRead,
	showComments = true,
} = Astro.props;
---

<html lang={SITE.lang}>
	<head>
		<BaseHead title={title} description={description} image={heroImage} type="article" />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 760px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1.5em;
				padding: 1em 0 0 0;
				text-align: center;
				line-height: 1.2;
			}
			.title h1 {
				margin: 0 0 0.4em 0;
				font-size: 2.4em;
			}
			.meta {
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: 0.6em;
				margin-bottom: 0.8em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.meta .sep::before {
				content: '·';
			}
			.draft-badge {
				display: inline-block;
				margin-bottom: 0.6em;
				padding: 0.2em 0.8em;
				border-radius: 4px;
				background: #ffe8a3;
				color: #7a5a00;
				font-size: 0.8em;
			}
			.title :global(.tags) {
				justify-content: center;
			}
			.prose :global(pre) {
				font-size: 0.8em;
				line-height: 1.5;
				overflow-x: auto;
			}
			.prose :global(h2) {
				margin-top: 2em;
				font-size: 1.8em;
			}
			.prose :global(h3) {
				margin-top: 1.5em;
				font-size: 1.4em;
			}
			.prose :global(p) {
				margin-bottom: 1.4em;
			}
			.prose :global(table) {
				border-collapse: collapse;
				font-size: 0.9em;
				display: block;
				overflow-x: auto;
			}
			.prose :global(th),
			.prose :global(td) {
				padding: 0.4em 0.8em;
				border: 1px solid rgb(var(--gray-light));
			}
			.prose :global(th) {
				background: rgba(var(--gray-light), 50%);
			}
			.prose :global(img) {
				display: block;
				margin: 1em auto;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						{draft && <div class="draft-badge">초안 — 배포에서 제외됨</div>}
						<h1>{title}</h1>
						<div class="meta">
							<FormattedDate date={pubDate} />
							{minutesRead && <span class="sep" />}
							{minutesRead && <span>{minutesRead} 읽기</span>}
							{
								updatedDate && (
									<>
										<span class="sep" />
										<span>
											수정: <FormattedDate date={updatedDate} />
										</span>
									</>
								)
							}
						</div>
						<Tags tags={tags} />
						<hr />
					</div>
					<slot />
					{showComments && <Giscus />}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

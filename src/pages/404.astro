---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE } from '../consts';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead title="페이지를 찾을 수 없습니다" description="요청하신 페이지가 없거나 주소가 바뀌었습니다." noindex />
	</head>
	<body>
		<Header />
		<main>
			<p class="eyebrow">404</p>
			<h1 class="page-title">페이지를 찾을 수 없습니다</h1>
			<p class="page-desc">주소가 바뀌었거나 없는 페이지입니다.</p>
			<ul class="links">
				<li><a href={base}>홈으로</a></li>
				<li><a href={`${base}posts/`}>전체 글</a></li>
				<li><a href={`${base}tags/`}>태그</a></li>
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.eyebrow {
		margin-bottom: var(--space-2);
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
	}
	.links {
		display: flex;
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>

---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE } from '../../consts';
import { getTagCounts, tagUrl } from '../../lib/posts';

const tags = await getTagCounts();
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead title="태그" description={`${SITE.title}의 태그 목록`} />
	</head>
	<body>
		<Header />
		<main>
			<h1>태그</h1>
			{
				tags.length === 0 ? (
					<p class="empty">아직 태그가 없습니다.</p>
				) : (
					<ul class="tag-cloud">
						{tags.map(([tag, count]) => (
							<li>
								<a href={tagUrl(tag)}>
									#{tag} <span class="count">{count}</span>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</main>
		<Footer />
	</body>
</html>
<style>
	h1 {
		font-size: 2em;
	}
	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6em;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.tag-cloud a {
		display: inline-block;
		padding: 0.3em 0.9em;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: 0.15s ease;
	}
	.tag-cloud a:hover {
		background: var(--accent);
		color: white;
	}
	.count {
		opacity: 0.7;
		font-size: 0.85em;
	}
	.empty {
		color: rgb(var(--gray));
	}
</style>

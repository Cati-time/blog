---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { SITE } from '../../consts';
import { getPosts, getTagCounts } from '../../lib/posts';

export async function getStaticPaths() {
	const tags = await getTagCounts();
	const posts = await getPosts();
	return tags.map(([tag]) => ({
		params: { tag },
		props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
	}));
}

const { tag, posts } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead title={`#${tag}`} description={`${tag} 태그가 달린 글 ${posts.length}개`} />
	</head>
	<body>
		<Header />
		<main>
			<a class="back" href={`${import.meta.env.BASE_URL}tags/`}>← 모든 태그</a>
			<h1 class="page-title" data-count={posts.length}>#{tag}</h1>
			<p class="page-desc">{tag} 태그가 달린 글입니다.</p>
			<PostList posts={posts} />
		</main>
		<Footer />
	</body>
</html>

<style>
	.back {
		display: inline-block;
		margin-bottom: var(--space-4);
		color: var(--color-text-subtle);
		font-size: var(--text-sm);
	}
	.back:hover {
		color: var(--color-accent);
	}
</style>

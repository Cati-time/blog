---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE } from '../consts';
import glossary from '../data/glossary.json';

// 정본은 src/data/glossary.json — 용어 검사(check:wording)도 같은 파일을 읽는다
const terms = glossary.terms.filter((t) => t.kind === 'concept');
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead title="용어" description={`${SITE.title}에서 쓰는 용어와 그 정의`} />
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title" data-count={terms.length}>용어</h1>
			<p class="page-desc">이 블로그의 글은 아래 이름으로 씁니다. 괄호 안은 다른 문서에서 만날 수 있는 다른 이름입니다.</p>
			<dl class="terms">
				{
					terms.map((t) => (
						<div class="term">
							<dt>
								<span class="name">{t.name}</span>
								{t.aliases.length > 0 && <span class="aliases">(다른 이름: {t.aliases.join(' · ')})</span>}
							</dt>
							<dd>{t.definition}</dd>
						</div>
					))
				}
			</dl>
		</main>
		<Footer />
	</body>
</html>

<style>
	.terms {
		display: grid;
		gap: var(--space-4);
		margin: 0;
	}
	.term {
		padding: var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}
	dt {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2);
	}
	.name {
		color: var(--color-text);
		font-weight: var(--weight-bold);
	}
	.aliases {
		color: var(--color-text-subtle);
		font-size: var(--text-sm);
	}
	dd {
		margin: var(--space-2) 0 0;
		color: var(--color-text-muted);
	}
</style>

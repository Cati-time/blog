---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../consts';
import { CATEGORIES, PLATFORMS, categoryUrl, filterPosts, getPosts } from '../lib/posts';

const posts = await getPosts();
const recent = posts.slice(0, SITE.recentPostsCount);
const base = import.meta.env.BASE_URL;
const homeUrl = new URL(base, Astro.site).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE.title,
	description: SITE.description,
	url: homeUrl,
	inLanguage: SITE.lang,
	publisher: { '@type': 'Organization', name: SITE.author, url: homeUrl },
};
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<BaseHead title={SITE.title} description={SITE.description} jsonLd={jsonLd} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">Tech Blog</p>
				<h1>{SITE.title}</h1>
				<p class="lead">{SITE.description}</p>
			</section>

			<section class="cats" aria-label="분류">
				{
					CATEGORIES.map((c) => (
						<article class="cat">
							<a class="cat-head" href={categoryUrl(c.id)}>
								<h2>{c.label}</h2>
								<span class="n">{filterPosts(posts, c.id).length}편</span>
							</a>
							<p class="cat-desc">{c.description}</p>
							<ul class="cat-subs">
								{PLATFORMS.map((p) => (
									<li>
										<a href={categoryUrl(c.id, p.id)}>{p.label}</a>
									</li>
								))}
							</ul>
						</article>
					))
				}
			</section>

			<section>
				<div class="section-head">
					<h2>최근 글</h2>
					{posts.length > recent.length && <a href={`${base}posts/`}>전체 글 보기 →</a>}
				</div>
				<PostList posts={recent} />
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: var(--space-8) 0 var(--space-10);
	}
	.eyebrow {
		margin-bottom: var(--space-3);
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
	}
	.hero h1 {
		font-size: var(--text-4xl);
		line-height: var(--leading-tight);
	}
	.lead {
		margin-top: var(--space-4);
		color: var(--color-text-muted);
		font-size: var(--text-lg);
		line-height: var(--leading-normal);
	}
	.cats {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-4);
		margin-bottom: var(--space-12);
	}
	.cat {
		display: flex;
		flex-direction: column;
		padding: var(--space-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		transition:
			border-color var(--duration-fast) var(--ease-standard),
			box-shadow var(--duration-fast) var(--ease-standard);
	}
	.cat:hover {
		border-color: var(--color-border-strong);
		box-shadow: var(--shadow-sm);
	}
	.cat-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		color: var(--color-text);
	}
	.cat-head h2 {
		font-size: var(--text-xl);
		transition: color var(--duration-fast) var(--ease-standard);
	}
	.cat-head:hover h2 {
		color: var(--color-accent);
	}
	.cat-head .n {
		color: var(--color-text-subtle);
		font-size: var(--text-sm);
	}
	.cat-desc {
		flex: 1;
		margin-top: var(--space-2);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}
	.cat-subs {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-3);
		margin: var(--space-4) 0 0;
		padding: var(--space-3) 0 0;
		border-top: 1px solid var(--color-border);
		list-style: none;
	}
	.cat-subs a {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}
	.cat-subs a:hover {
		color: var(--color-accent);
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: var(--space-4);
		padding-bottom: var(--space-3);
		border-bottom: 1px solid var(--color-border);
	}
	.section-head h2 {
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-text-muted);
		letter-spacing: var(--tracking-normal);
	}
	.section-head a {
		font-size: var(--text-sm);
	}
	@media (max-width: 40rem) {
		.hero {
			padding: var(--space-4) 0 var(--space-8);
		}
		.hero h1 {
			font-size: var(--text-3xl);
		}
		.lead {
			font-size: var(--text-base);
		}
		.cats {
			grid-template-columns: 1fr;
		}
	}
</style>

{
	"name": "blog",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "npm run check && astro build",
		"preview": "astro preview",
		"check": "node scripts/check-tokens.mjs && node scripts/check-posts.mjs && astro check",
		"new": "node scripts/new-post.mjs",
		"astro": "astro",
		"check:tokens": "node scripts/check-tokens.mjs",
		"check:posts": "node scripts/check-posts.mjs",
		"import": "node scripts/import-doc.mjs"
	},
	"dependencies": {
		"@astrojs/mdx": "^8.0.1",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"astro": "^7.3.2",
		"sharp": "^0.35.0"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/markdown-satteri": "^0.4.1",
		"@mixmark-io/domino": "^2.2.0",
		"reading-time": "^1.5.0",
		"turndown": "^7.2.4",
		"turndown-plugin-gfm": "^1.0.2",
		"typescript": "^6.0.3"
	}
}
